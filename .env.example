# text2sql 环境变量模板
#
# 复制为 .env 后按需填写（.env 已在 .gitignore 中）。什么都不填也能运行：
# 没有数据库主机时使用本地合成演示库，没有模型 Key 时只启用语义层路径。
# Streamlit Cloud 上在 Secrets 里配置同名键。旧版脚本（legacy/）的变量见 legacy/.env.local.example。

# ---------------------------------------------------------------- 模型（可选）
# 任意 OpenAI 兼容接口。LLM_PROVIDER 可选 openai_compatible / deepseek。
LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=your-api-key
# 不填时使用 text2sql/config.py 里的默认地址与模型
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
# OPENAI_MODEL=your-model-name
MODEL_TEMPERATURE=0.1
LLM_TIMEOUT=60
T2S_AGENT_MAX_STEPS=8

# LLM_PROVIDER=deepseek 时读取以下三项
# DEEPSEEK_API_KEY=your-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------- 数据库（可选）
# auto：配置了主机就连 MySQL，否则用演示库；demo / mysql：强制指定
T2S_DATABASE=auto
DB_HOST_SCENARIO_1_3=your-db-host
DB_PORT_SCENARIO_1_3=3306
DB_NAME_SCENARIO_1_3=znjz
DB_USER_SCENARIO_1_3=your-readonly-user
DB_PASSWORD_SCENARIO_1_3=your-db-password
# 演示库文件位置（默认 data/demo/znjz_demo.duckdb，首次运行自动生成）
# T2S_DEMO_DB_PATH=data/demo/znjz_demo.duckdb

# ---------------------------------------------------------------- 安全与限流
# Streamlit 页面口令；为空时不设口令
APP_PASSWORD=change-me
T2S_MAX_ROWS=500
T2S_MAX_REPAIRS=2
T2S_QUERY_TIMEOUT=20
T2S_COST_LIMIT=50000000
# 结果解读是否调用模型（关闭后由查询结果直接生成，数字全部可核对）
T2S_LLM_NARRATIVE=true
# FastAPI 的跨域来源（逗号分隔）与每个 IP 的请求频率
T2S_ALLOWED_ORIGINS=http://localhost:8501
T2S_RATE_LIMIT=30/minute
