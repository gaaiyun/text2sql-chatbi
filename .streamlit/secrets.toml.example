# Streamlit Cloud：App settings → Secrets 里粘贴以下内容并替换取值。
# 不配置模型与数据库时，应用使用合成演示库和语义层路径，同样可以运行。

LLM_PROVIDER = "openai_compatible"
OPENAI_API_KEY = "your-api-key"
# OPENAI_BASE_URL = "https://your-openai-compatible-endpoint/v1"
# OPENAI_MODEL = "your-model-name"
MODEL_TEMPERATURE = "0.1"

APP_PASSWORD = "change-me"

T2S_DATABASE = "auto"
DB_HOST_SCENARIO_1_3 = "your-db-host"
DB_PORT_SCENARIO_1_3 = "3306"
DB_NAME_SCENARIO_1_3 = "znjz"
DB_USER_SCENARIO_1_3 = "your-readonly-user"
DB_PASSWORD_SCENARIO_1_3 = "your-db-password"
